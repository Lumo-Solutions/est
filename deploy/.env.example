# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=1

# --- database ---
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/installtec_core
APP_DB_USER=installtec_app
APP_DB_PASSWORD=change-me
MIGRATOR_DB_USER=installtec_migrator
MIGRATOR_DB_PASSWORD=change-me-migrator
# used by alembic (schema owner); the app itself connects as APP_DB_USER, never as this role
MIGRATOR_DATABASE_URL=postgresql://installtec_migrator:change-me-migrator@postgres:5432/installtec_core
# used by the running app for all request/task traffic; RLS depends on this NOT being the table owner
APP_DATABASE_URL=postgresql://installtec_app:change-me@postgres:5432/installtec_core

# --- redis / celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- object storage (SeaweedFS, S3-compatible) ---
S3_ENDPOINT=http://seaweedfs:8333
# Browser-facing host for presigned download URLs (drawing viewer, Phase
# 8b) -- S3_ENDPOINT only resolves inside the compose network. Matches
# the seaweedfs service's own host port mapping in docker-compose.yml.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=installtec
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET_DRAWINGS=installtec-drawings
S3_BUCKET_PROCUREMENT=installtec-procurement
S3_FORCE_PATH_STYLE=true

# --- ai (vLLM defaults to the local mock until a GPU host is provisioned) ---
VLLM_API_BASE=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_API_KEY=not-needed
VLLM_TIMEOUT_S=120
EMBEDDING_BACKEND=onnx
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
ONNX_MODEL_DIR=/models

# --- identity (Keycloak) ---
KEYCLOAK_BASE_URL=http://keycloak:8080
# Both of these point at the caddy-dev proxy
# (deploy/docker-compose.override.dev.yml / deploy/caddy/Caddyfile.dev), not
# at Keycloak's own :8080 port directly -- Keycloak always marks its
# login-flow cookies Secure+SameSite=None, which a real browser refuses to
# send back over plain HTTP, so the interactive login form needs a genuine
# (even if self-signed) TLS hop in front of it. KEYCLOAK_HOSTNAME accepts a
# full URL (Keycloak 26's hostname-v2 provider), which is what fixes the
# issuer Keycloak puts in every token to match KEYCLOAK_PUBLIC_URL exactly,
# regardless of which port a request actually arrived on (dev-token.sh
# still talks to :8080 directly for scripted access -- see its own
# comment). See docs/keycloak-setup.md's "Interactive browser login in
# dev" section.
KEYCLOAK_PUBLIC_URL=https://localhost:8443
KEYCLOAK_HOSTNAME=https://localhost:8443
KEYCLOAK_REALM=installtec
KEYCLOAK_CLIENT_ID=installtec-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_AUDIENCE=installtec-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
REQUIRED_ACR_FOR_APPROVAL=silver
# DEV/TEST ONLY. true turns MFA off: deploy/keycloak/bootstrap.sh drops the
# login OTP and the backend skips the step-up check (logged as a WARNING and
# recorded as mfa_bypassed_dev=true in the audit event; the frontend shows a
# "DEV: MFA disabled" banner). Honoured only when APP_ENV is exactly dev or
# test; the backend refuses to start with it true under any other APP_ENV.
# Leave false everywhere else. Flip with `make dev-mfa-off` / `make dev-mfa-on`.
DEV_DISABLE_MFA=false
JWKS_CACHE_TTL_S=600
LEEWAY_S=30

# --- session / cookies (BFF pattern: opaque session id, tokens stay server-side) ---
SESSION_SECRET=base64-32-bytes-placeholder
# app/security/cookies.py hardcodes the __Host- cookie name prefix, which
# browsers only ever accept together with the Secure attribute -- so
# COOKIE_SECURE=false (the old default, from when dev had no TLS anywhere)
# actually made the browser silently drop the session cookie on every
# login, __Host- prefix or not. Now that caddy-dev provides a real (if
# self-signed) TLS hop in front of both Keycloak and the frontend, this
# must be true in dev too, same as it already defaults to in
# app/core/config.py.
COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
SESSION_TTL_S=28800
CSRF_HEADER=X-CSRF-Token

# --- audit ---
AUDIT_ALL_READS=false
AUDIT_CHECKPOINT_HMAC_KEY=base64-32-bytes-placeholder

# --- takeoff geometry (Phase 2) ---
# Persists DXF geometric entities (LINE/LWPOLYLINE/ARC/INSERT, not just
# text) to drawing_entities.geometry during ingestion, and runs the
# geometry extractors (alignment/corridor/trench/pipe-network) afterward,
# writing results to drawing_measurements. Off by default: the geometric
# entity harvest/persist is extra work most sheets don't need, and the
# extractors' layer-name/attribute conventions (see
# backend/app/takeoff/geometry/config.py) are unvalidated against real
# client drawings. See docs/takeoff-pipeline.md.
TAKEOFF_PERSIST_GEOMETRY=false

# --- default tenant (matches deploy/keycloak/realm-installtec.json /tenants/demo group) ---
DEMO_TENANT_ID=8f14e45f-ceea-4e97-8d0c-3d3b3f3c1a00

# --- procurement (Module C1: RFQ generation & dispatch) ---
# Dev/test default: Mailpit (deploy/docker-compose.yml), a fake SMTP sink
# with a web UI at http://localhost:8025 -- never a real relay here.
# For a real deployment, point these at your SMTP relay and set
# APP_ENV=production so EMAIL_REDIRECT_ALL_TO stops applying (see
# app/procurement/mailer.py::resolve_recipient and docs/procurement-rfq.md).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_ADDRESS=procurement@installtec.local
EMAIL_REPLY_TO_LOCAL_PART=rfq
EMAIL_REPLY_TO_DOMAIN=installtec.local
# REQUIRED whenever APP_ENV != production: every outbound RFQ email is sent
# here instead of the vendor's real address, regardless of SMTP_HOST -- the
# app refuses to dispatch (fails closed) if this is blank in a non-production
# environment. Ignored when APP_ENV=production.
EMAIL_REDIRECT_ALL_TO=dev-catchall@installtec.local

# --- procurement (Module C2: inbound quotation ingestion) ---
# Dev/test default: GreenMail (deploy/docker-compose.yml) -- Mailpit above
# has no IMAP server, so it can't serve this role. For a real deployment,
# point these at your real IMAP mailbox and set APP_ENV=production so
# IMAP_DEV_ALLOWED_HOST stops applying (see
# app/workers/tasks/quotation_ingestion.py::_assert_dev_imap_host_is_safe
# and docs/procurement-quotation-ingestion.md).
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USE_SSL=false
IMAP_USER=rfq@installtec.local
IMAP_PASSWORD=anything
IMAP_MAILBOX=INBOX
# REQUIRED (fails closed) whenever APP_ENV != production: IMAP_HOST must
# equal this value or the poller refuses to start. Ignored when
# APP_ENV=production.
IMAP_DEV_ALLOWED_HOST=greenmail
QUOTATION_MAX_ATTACHMENT_SIZE_BYTES=15728640
QUOTATION_MAX_PDF_PAGES=60
