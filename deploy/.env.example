# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=1

# --- database ---
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/installtec_core
APP_DB_USER=installtec_app
APP_DB_PASSWORD=change-me
MIGRATOR_DB_USER=installtec_migrator
MIGRATOR_DB_PASSWORD=change-me-migrator
# used by alembic (schema owner); the app itself connects as APP_DB_USER, never as this role
MIGRATOR_DATABASE_URL=postgresql://installtec_migrator:change-me-migrator@postgres:5432/installtec_core
# used by the running app for all request/task traffic; RLS depends on this NOT being the table owner
APP_DATABASE_URL=postgresql://installtec_app:change-me@postgres:5432/installtec_core

# --- redis / celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- object storage (SeaweedFS, S3-compatible) ---
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=installtec
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET_DRAWINGS=installtec-drawings
S3_FORCE_PATH_STYLE=true

# --- ai (vLLM defaults to the local mock until a GPU host is provisioned) ---
VLLM_API_BASE=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_API_KEY=not-needed
VLLM_TIMEOUT_S=120
EMBEDDING_BACKEND=onnx
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
ONNX_MODEL_DIR=/models

# --- identity (Keycloak) ---
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_REALM=installtec
KEYCLOAK_CLIENT_ID=installtec-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_AUDIENCE=installtec-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
REQUIRED_ACR_FOR_APPROVAL=silver
JWKS_CACHE_TTL_S=600
LEEWAY_S=30

# --- session / cookies (BFF pattern: opaque session id, tokens stay server-side) ---
SESSION_SECRET=base64-32-bytes-placeholder
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
SESSION_TTL_S=28800
CSRF_HEADER=X-CSRF-Token

# --- audit ---
AUDIT_ALL_READS=false
AUDIT_CHECKPOINT_HMAC_KEY=base64-32-bytes-placeholder

# --- default tenant (matches deploy/keycloak/realm-installtec.json /tenants/demo group) ---
DEMO_TENANT_ID=8f14e45f-ceea-4e97-8d0c-3d3b3f3c1a00
